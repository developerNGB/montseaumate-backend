# Server Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/montseaumate

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_RENEW_IF_EXPIRES_WITHIN_SECONDS=172800

TRANSLATION_EDITOR_USER_IDS=
FOLLOWUP_STUCK_PROCESSING_MINUTES=45

# Frontend URL (for CORS and Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173

# Stripe (EUR subscriptions) — https://dashboard.stripe.com
# Products: Starter €39/mo, Growth €69/mo, Pro €119/mo (recurring). Do NOT add trial on the Price — use STRIPE_TRIAL_DAYS at checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_TRIAL_DAYS=30

# Email — Gmail app password (OTP, password reset, contact form fallback)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Contact form SMTP (recommended on production — e.g. CDMON). Used when all three are set.
SUPPORT_SMTP_HOST=mail.cdmon.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_SECURE=true
SUPPORT_SMTP_USER=info@yourdomain.com
SUPPORT_SMTP_PASS=your-smtp-password
SUPPORT_EMAIL=info@yourdomain.com

# Where landing contact enquiries are delivered
# Where landing contact submissions are delivered (defaults to EMAIL_USER before SUPPORT_EMAIL)
CONTACT_FORM_TO=equipoexpertoia@gmail.com
# Optional override; otherwise first TRANSLATION_EDITOR_USER_IDS with Gmail connected is used
CONTACT_FORM_SENDER_USER_ID=
# Production (Render): Gmail API via Integrations — EMAIL_PASS is for OTP/local SMTP only
ADMIN_ALERT_EMAIL=equipoexpertoia@gmail.com

# Follow-up cron — minutes between retries after a failed send; hours between admin failure emails
FOLLOWUP_RETRY_COOLDOWN_MINUTES=60
FOLLOWUP_ALERT_COOLDOWN_MINUTES=360

# Apollo.io API Key (for lead discovery)
APOLLO_API_KEY=your_apollo_api_key_here
