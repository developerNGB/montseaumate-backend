# Server Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/montseaumate

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_RENEW_IF_EXPIRES_WITHIN_SECONDS=172800

TRANSLATION_EDITOR_USER_IDS=
FOLLOWUP_STUCK_PROCESSING_MINUTES=45

# Frontend URL (for CORS and Stripe redirect URLs)
FRONTEND_URL=http://localhost:5173

# Stripe (EUR subscriptions) — https://dashboard.stripe.com
# Products: Starter €39/mo, Growth €69/mo, Pro €119/mo (recurring). Do NOT add trial on the Price — use STRIPE_TRIAL_DAYS at checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_TRIAL_DAYS=30

# Email — Gmail app password (OTP, password reset, contact form fallback)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Support / admin alerts (CDMON SMTP) — not used by the landing contact form
SUPPORT_SMTP_HOST=mail.cdmon.com
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_SECURE=true
SUPPORT_SMTP_USER=info@yourdomain.com
SUPPORT_SMTP_PASS=your-smtp-password
SUPPORT_EMAIL=info@yourdomain.com

# Landing contact form — inbox + preferred FROM address (matches EMAIL_USER for SMTP)
CONTACT_FORM_TO=equipoexpertoia@gmail.com
# Sends via EMAIL_USER/EMAIL_PASS (Gmail SMTP) when it matches CONTACT_FORM_TO, then Google integrations
# Optional: user UUID — only if their connected Google email matches CONTACT_FORM_TO
# CONTACT_FORM_SENDER_USER_ID=
# Optional: OAuth refresh token for CONTACT_FORM_GOOGLE_FROM (priority over SMTP)
# CONTACT_FORM_GOOGLE_REFRESH_TOKEN=
# CONTACT_FORM_GOOGLE_FROM=equipoexpertoia@gmail.com
ADMIN_ALERT_EMAIL=equipoexpertoia@gmail.com
# Comma-separated emails with full dashboard + Pro plan entitlements (no Stripe required)
ADMIN_EMAILS=you@company.com,other@company.com

# Follow-up cron — minutes between retries after a failed send; hours between admin failure emails
FOLLOWUP_RETRY_COOLDOWN_MINUTES=60
FOLLOWUP_ALERT_COOLDOWN_MINUTES=360

# Apollo.io API Key (for lead discovery)
APOLLO_API_KEY=your_apollo_api_key_here
